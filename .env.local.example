# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging (FCM) - Web Push Notifications
NEXT_PUBLIC_VAPID_KEY=your_vapid_public_key_here

# Razorpay Configuration
# Get these from: https://dashboard.razorpay.com/app/keys

# Test Mode Keys (for development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=your_key_secret_here

# Live Mode Keys (for production - uncomment when going live)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID_HERE
# RAZORPAY_KEY_SECRET=your_live_key_secret_here

# Instructions:
# 1. Copy this file and rename it to .env.local
# 2. Replace YOUR_KEY_ID_HERE with your actual Razorpay Key ID
# 3. Replace your_key_secret_here with your actual Razorpay Key Secret
# 4. Never commit .env.local to git (it's in .gitignore)
